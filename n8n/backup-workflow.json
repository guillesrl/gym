    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO entreno_brutal_backups (user_id, backup_date, payload) VALUES ($1, $2, $3::jsonb) ON CONFLICT (user_id, backup_date) DO UPDATE SET payload = EXCLUDED.payload, updated_at = now();",
        "options": {
          "queryReplacement": "={{ $json.body.user }},={{ $now.format('yyyy-MM-dd') }},={{ JSON.stringify($json.body) }}"
        }
