    {
      "id": "ab1ce139-e6e6-483e-b4e2-05b6c27afbef",
      "name": "Leer último backup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        100,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT payload FROM (SELECT payload, 1 AS priority, backup_date, updated_at FROM entreno_brutal_backups WHERE user_id = $1 UNION ALL SELECT NULL::jsonb AS payload, 2 AS priority, NULL::date AS backup_date, NULL::timestamp AS updated_at) candidates ORDER BY priority, backup_date DESC NULLS LAST, updated_at DESC NULLS LAST LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.query.user }}"
        }
      },
